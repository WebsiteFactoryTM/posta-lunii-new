# ---------------------------------------------------------------------------
# Poșta Lunii — variabile de mediu
# ---------------------------------------------------------------------------

# Cheia cu care Payload semnează token-urile. Obligatorie. Generează una nouă:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=schimba-aceasta-cheie

# Baza de date Postgres (Neon). În Vercel e setată de integrarea Neon.
# Local: `vercel env pull` sau un Postgres propriu.
DATABASE_URL=postgres://user:parola@host/baza?sslmode=require

# URL-ul public al site-ului — folosit pentru canonical, sitemap, OG, schema.org.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Verificări motoare de căutare (opțional)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google Analytics 4 — se încarcă doar după acordul vizitatorului (bannerul de cookie).
# NEXT_PUBLIC_GA_ID=G-G5E9T34WP3

# Emailuri prin Resend (confirmări de comandă și de retragere, notificări admin).
# Fără cheie, comenzile și retragerile se salvează, dar emailurile nu pleacă.
# RESEND_API_KEY=re_...
# Expeditorul — domeniul trebuie verificat în Resend → Domains.
# EMAIL_FROM=contact@postalunii.ro
# Unde ajung notificările de comandă și retragere.
# ADMIN_EMAIL=contact@adinaslach.com

# Meta Pixel + Conversions API ------------------------------------------------
# Pixelul se încarcă doar după acordul pentru cookie-urile de marketing.
# NEXT_PUBLIC_META_PIXEL_ID=1441607221249526
# Token-ul Conversions API (Events Manager → Setări → Generează token de acces).
# META_CAPI_ACCESS_TOKEN=
# Doar pentru verificare în Events Manager → Testează evenimentele; șterge-l după test.
# META_TEST_EVENT_CODE=TEST12345

# Stripe — pentru pagina de confirmare (/multumim) și webhook (/webhooks/stripe).
# Cheie restricționată cu acces „Read” la Checkout Sessions este suficientă.
# STRIPE_SECRET_KEY=rk_live_...
# Signing secret-ul endpoint-ului de webhook (Developers → Webhooks).
# STRIPE_WEBHOOK_SECRET=whsec_...

# Poșta Secretă — linkurile Stripe Payment Link (buy.stripe.com/…) pentru cele 3
# planuri. Același flux ca la Poșta Lunii: butonul adaugă singur client_reference_id
# (ps1_…), iar webhook-ul salvează comanda ca „Poșta Secretă” și trimite emailurile ei.
# TODO (Ernest), pentru fiecare link:
#   - produsul Stripe are metadata  linie = posta-secreta
#   - colectează adresa de livrare (România) și telefonul
#   - „După plată” → redirect la https://postalunii.ro/multumim?session_id={CHECKOUT_SESSION_ID}
#   o lună:   plată unică 60 lei
#   lunar:    abonament recurent 55 lei / lună
#   integral: plată unică 660 lei (12 plicuri)
# Cheia STRIPE_SECRET_KEY are nevoie și de acces „Read” la Products (pentru metadata linie).
STRIPE_LINK_POSTA_SECRETA_O_LUNA=
STRIPE_LINK_POSTA_SECRETA_LUNAR=
STRIPE_LINK_POSTA_SECRETA_INTEGRAL=

# Portalul de clienți Stripe (Settings → Billing → Customer portal → linkul de login),
# folosit în emailul Poștei Secrete pentru schimbarea adresei / oprirea abonamentului.
# Fără el, emailul trimite la adresa de contact.
# STRIPE_CUSTOMER_PORTAL_URL=https://billing.stripe.com/p/login/...
