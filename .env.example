# ---------------------------------------------------------------------------
# Poșta Lunii — variabile de mediu
# ---------------------------------------------------------------------------

# Cheia cu care Payload semnează token-urile. Obligatorie. Generează una nouă:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=schimba-aceasta-cheie

# Baza de date. Implicit SQLite local (fișier), zero configurare.
#   SQLite local:   file:./posta-lunii.db
#   Turso / libSQL: libsql://numele-bazei.turso.io   (+ DATABASE_AUTH_TOKEN)
DATABASE_URI=file:./posta-lunii.db
# DATABASE_AUTH_TOKEN=

# URL-ul public al site-ului — folosit pentru canonical, sitemap, OG, schema.org.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Verificări motoare de căutare (opțional)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google Analytics 4 — se încarcă doar după acordul vizitatorului (bannerul de cookie).
# NEXT_PUBLIC_GA_ID=G-G5E9T34WP3

# SMTP pentru emailuri (confirmarea retragerii din contract). Fără el, confirmarea
# apare doar pe ecran și cererea se salvează în admin, dar nu pleacă emailul.
# SMTP_HOST=smtp.exemplu.ro
# SMTP_PORT=465
# SMTP_USER=contact@adinaslach.com
# SMTP_PASS=
# SMTP_FROM=contact@adinaslach.com

# Meta Pixel + Conversions API ------------------------------------------------
# Pixelul se încarcă doar după acordul pentru cookie-urile de marketing.
# NEXT_PUBLIC_META_PIXEL_ID=1441607221249526
# Token-ul Conversions API (Events Manager → Setări → Generează token de acces).
# META_CAPI_ACCESS_TOKEN=
# Doar pentru verificare în Events Manager → Testează evenimentele; șterge-l după test.
# META_TEST_EVENT_CODE=TEST12345

# Stripe — pentru pagina de confirmare (/multumim) și webhook (/webhooks/stripe).
# Cheie restricționată cu acces „Read” la Checkout Sessions este suficientă.
# STRIPE_SECRET_KEY=rk_live_...
# Signing secret-ul endpoint-ului de webhook (Developers → Webhooks).
# STRIPE_WEBHOOK_SECRET=whsec_...
